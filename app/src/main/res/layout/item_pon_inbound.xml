<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <TextView
        android:id="@+id/item_sn"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:gravity="center"
        tools:text="123"
        android:textColor="@color/black"
        android:textSize="15sp"
        app:layout_constraintWidth_percent="0.2"
        app:layout_constraintEnd_toStartOf="@+id/item_traking_id"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/item_traking_id"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:gravity="center"
        tools:text="Tracking#"
        android:textColor="@color/black"
        android:textSize="15sp"
        app:layout_constraintWidth_percent="0.4"
        app:layout_constraintEnd_toStartOf="@+id/item_post_office"
        app:layout_constraintStart_toEndOf="@+id/item_sn"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/item_post_office"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:gravity="center"
        tools:text="Postal Code"
        android:textColor="@color/black"
        android:textSize="15sp"
        app:layout_constraintWidth_percent="0.4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/item_traking_id"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>