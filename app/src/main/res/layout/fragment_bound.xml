<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_main_btn"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/tv_back"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="10dp"
            android:paddingVertical="18dp"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/inbound_title"
            android:textColor="#0055A3"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_rfid_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="#0055A3"
            app:layout_constraintStart_toEndOf="@+id/tv_title"
            app:layout_constraintEnd_toStartOf="@+id/img_power"
            app:layout_constraintTop_toTopOf="@+id/tv_title"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title" />

        <ImageView
            android:id="@+id/img_power"
            android:layout_width="30dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:layout_marginEnd="7dp"
            android:src="@drawable/ic_power"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/v_scan_hint"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_scan_hint"
        app:layout_constraintTop_toTopOf="@+id/tv_scan_hint"
        app:layout_constraintBottom_toBottomOf="@+id/tv_scan_hint" />

    <TextView
        android:id="@+id/tv_scan_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@+id/title_layout"
        app:layout_constraintBottom_toTopOf="@+id/table_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/table_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_scan_hint"
        app:layout_constraintBottom_toTopOf="@+id/btn_clear">

        <TextView
            android:id="@+id/tv_sn_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="SN"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintWidth_percent="0.1"
            app:layout_constraintEnd_toStartOf="@+id/tv_traking_id_head"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_traking_id_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Tracking ID"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintWidth_percent="0.35"
            app:layout_constraintEnd_toStartOf="@+id/tv_postal_code_head"
            app:layout_constraintStart_toEndOf="@+id/tv_sn_head"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_postal_code_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Postal Code"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintWidth_percent="0.2"
            app:layout_constraintEnd_toStartOf="@+id/tv_beat_head"
            app:layout_constraintStart_toEndOf="@+id/tv_traking_id_head"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_beat_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Beat"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintWidth_percent="0.2"
            app:layout_constraintEnd_toStartOf="@+id/tv_other_head"
            app:layout_constraintStart_toEndOf="@+id/tv_postal_code_head"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_other_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="DB"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintWidth_percent="0.15"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_beat_head"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#3c3c3c"
            android:layout_marginTop="5dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_sn_head" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_sn_head"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <Button
        android:id="@+id/btn_clear"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:text="Clear"
        android:background="@drawable/bg_grey_5"
        android:layout_marginBottom="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_upload" />

    <Button
        android:id="@+id/btn_upload"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:text="Upload"
        android:textColor="@color/white"
        android:background="@drawable/bg_blue_5"
        app:layout_constraintBottom_toBottomOf="@+id/btn_clear"
        app:layout_constraintStart_toEndOf="@+id/btn_clear"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>