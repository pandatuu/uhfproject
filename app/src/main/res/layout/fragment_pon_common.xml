<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_layout"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_glass_title"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/tv_back"
            android:layout_width="48dp"
            android:layout_height="0dp"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="#0055A3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/inbound_title"
            android:textColor="#0055A3"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_rfid_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="#0055A3"
            app:layout_constraintStart_toEndOf="@+id/tv_title"
            app:layout_constraintEnd_toStartOf="@+id/img_power"
            app:layout_constraintTop_toTopOf="@+id/tv_title"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title" />

        <ImageView
            android:id="@+id/img_power"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="1dp"
            android:layout_marginEnd="7dp"
            android:src="@drawable/ic_power"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@id/tv_post1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Post Office"
        android:textSize="16sp"
        android:textColor="@color/black"
        app:layout_constraintTop_toTopOf="@+id/spinner"
        app:layout_constraintBottom_toBottomOf="@+id/spinner"
        app:layout_constraintStart_toStartOf="@+id/title_layout" />

    <Spinner
        android:id="@+id/spinner"
        android:layout_width="120dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_border_gray_5"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@+id/tv_post1"
        app:layout_constraintTop_toBottomOf="@+id/title_layout" />

    <TextView
        android:id="@id/tv_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Progress:0/0"
        android:textSize="16sp"
        android:textColor="@color/black"
        app:layout_constraintTop_toTopOf="@+id/tv_post1"
        app:layout_constraintBottom_toBottomOf="@+id/tv_post1"
        app:layout_constraintEnd_toEndOf="@+id/title_layout"
        app:layout_constraintStart_toEndOf="@+id/spinner" />

    <TextView
        android:id="@+id/tv_sn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="SN"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:paddingVertical="5dp"
        android:gravity="center"
        android:layout_marginTop="10dp"
        app:layout_constraintWidth_percent="0.2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spinner"
        app:layout_constraintEnd_toStartOf="@+id/tv_tracking_id" />
    <TextView
        android:id="@+id/tv_tracking_id"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Tracking#"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:paddingVertical="5dp"
        android:gravity="center"
        app:layout_constraintWidth_percent="0.4"
        app:layout_constraintStart_toEndOf="@+id/tv_sn"
        app:layout_constraintTop_toTopOf="@+id/tv_sn"
        app:layout_constraintEnd_toStartOf="@+id/tv_post_office" />
    <TextView
        android:id="@+id/tv_post_office"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Post Office"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:paddingVertical="5dp"
        android:gravity="center"
        app:layout_constraintWidth_percent="0.4"
        app:layout_constraintStart_toEndOf="@+id/tv_tracking_id"
        app:layout_constraintTop_toTopOf="@+id/tv_tracking_id"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/black"
        app:layout_constraintTop_toBottomOf="@+id/tv_post_office" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/inbound_rv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="10dp"
        tools:listitem="@layout/item_pon_inbound"
        app:layout_constraintTop_toBottomOf="@+id/tv_post_office"
        app:layout_constraintBottom_toTopOf="@+id/btn_exceptions" />

    <TextView
        android:id="@+id/btn_exceptions"
        android:layout_width="120dp"
        android:layout_height="45dp"
        android:text="Exceptions:0"
        android:textSize="16sp"
        android:gravity="center"
        android:textColor="@color/white"
        android:background="@drawable/bg_red_20"
        android:layout_marginBottom="10dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btn_clear" />
    <TextView
        android:id="@+id/btn_clear"
        android:layout_width="120dp"
        android:layout_height="45dp"
        android:text="Clear"
        android:textSize="16sp"
        android:gravity="center"
        android:textColor="@color/white"
        android:background="@drawable/bg_gray_5_1"
        android:layout_marginBottom="10dp"
        app:layout_constraintEnd_toStartOf="@+id/btn_upload"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/btn_upload"
        android:layout_width="120dp"
        android:layout_height="45dp"
        android:text="Upload"
        android:textSize="16sp"
        android:gravity="center"
        android:textColor="@color/white"
        app:layout_constraintStart_toEndOf="@+id/btn_clear"
        android:background="@drawable/bg_blue_5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/btn_clear"/>

</androidx.constraintlayout.widget.ConstraintLayout>