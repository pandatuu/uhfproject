<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_white_10">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_sn_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="SN"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintWidth_percent="0.1"
            app:layout_constraintEnd_toStartOf="@+id/tv_traking_id_head"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_traking_id_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Tracking#"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintWidth_percent="0.26"
            app:layout_constraintEnd_toStartOf="@+id/tv_postal_code_head"
            app:layout_constraintStart_toEndOf="@+id/tv_sn_head"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_postal_code_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Postal Code"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintWidth_percent="0.23"
            app:layout_constraintEnd_toStartOf="@+id/tv_beat_head"
            app:layout_constraintStart_toEndOf="@+id/tv_traking_id_head"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_beat_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Beat"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintWidth_percent="0.23"
            app:layout_constraintEnd_toStartOf="@+id/tv_other_head"
            app:layout_constraintStart_toEndOf="@+id/tv_postal_code_head"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_other_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="LM"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintWidth_percent="0.18"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_beat_head"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#3c3c3c"
            android:layout_marginTop="5dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_sn_head" />

        <com.scwang.smart.refresh.layout.SmartRefreshLayout
            android:id="@+id/smart_refresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_sn_head" >

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.scwang.smart.refresh.footer.ClassicsFooter
                android:id="@+id/smart_refresh_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.scwang.smart.refresh.layout.SmartRefreshLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>