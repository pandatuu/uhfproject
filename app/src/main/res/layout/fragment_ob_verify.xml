<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_main_btn"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/tv_back"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="10dp"
            android:paddingVertical="18dp"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Outbound Verify"
            android:textColor="#0055A3"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_rfid_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="#0055A3"
            app:layout_constraintStart_toEndOf="@+id/tv_title"
            app:layout_constraintEnd_toStartOf="@+id/img_power"
            app:layout_constraintTop_toTopOf="@+id/tv_title"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title" />

        <ImageView
            android:id="@+id/img_power"
            android:layout_width="30dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:layout_marginEnd="7dp"
            android:src="@drawable/ic_power"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <EditText
        android:id="@+id/edt_db"
        android:layout_width="60dp"
        android:layout_height="30dp"
        android:layout_marginTop="10dp"
        android:paddingHorizontal="8dp"
        android:hint="Beat"
        android:background="@drawable/bg_blue_border_5"
        app:layout_constraintStart_toStartOf="@+id/title_layout"
        app:layout_constraintTop_toBottomOf="@+id/title_layout" />

    <TextView
        android:id="@+id/btn_query"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Query"
        android:padding="5dp"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#1716FE"
        android:layout_marginStart="5dp"
        app:layout_constraintStart_toEndOf="@+id/edt_db"
        app:layout_constraintTop_toTopOf="@+id/edt_db"
        app:layout_constraintBottom_toBottomOf="@+id/edt_db" />

    <LinearLayout
        android:id="@+id/statistics_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="@+id/edt_db"
        app:layout_constraintBottom_toBottomOf="@+id/edt_db"
        app:layout_constraintEnd_toEndOf="@+id/title_layout" >

        <TextView
            android:id="@+id/tv_backlog_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1716FE"
            tools:text="B:254" />

        <TextView
            android:id="@+id/tv_total_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1716FE"
            tools:text="T:254" />

        <TextView
            android:id="@+id/tv_completed_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#02790E"
            tools:text="C:254" />

        <TextView
            android:id="@+id/tv_error_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#D9001B"
            tools:text="E:254" />


    </LinearLayout>

    <View
        android:id="@+id/v_scan_hint"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_scan_hint"
        app:layout_constraintTop_toBottomOf="@+id/edt_db"
        app:layout_constraintBottom_toBottomOf="@+id/tv_scan_hint" />

    <TextView
        android:id="@+id/tv_scan_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@+id/edt_db"
        app:layout_constraintBottom_toTopOf="@+id/table_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/table_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_scan_hint"
        app:layout_constraintBottom_toTopOf="@+id/btn_clear">

        <TextView
            android:id="@+id/tv_sn_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="SN"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintWidth_percent="0.1"
            app:layout_constraintEnd_toStartOf="@+id/tv_traking_id_head"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_traking_id_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Tracking#"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintWidth_percent="0.26"
            app:layout_constraintEnd_toStartOf="@+id/tv_postal_code_head"
            app:layout_constraintStart_toEndOf="@+id/tv_sn_head"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_postal_code_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Postal Code"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintWidth_percent="0.23"
            app:layout_constraintEnd_toStartOf="@+id/tv_beat_head"
            app:layout_constraintStart_toEndOf="@+id/tv_traking_id_head"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_beat_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Beat"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintWidth_percent="0.23"
            app:layout_constraintEnd_toStartOf="@+id/tv_other_head"
            app:layout_constraintStart_toEndOf="@+id/tv_postal_code_head"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_other_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="RB"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintWidth_percent="0.18"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_beat_head"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#3c3c3c"
            android:layout_marginTop="5dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_sn_head" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_sn_head"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <Button
        android:id="@+id/btn_clear"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:text="Clear"
        android:background="@drawable/bg_gray_5"
        android:layout_marginBottom="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_upload" />

    <Button
        android:id="@+id/btn_upload"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:text="Upload"
        android:textColor="@color/white"
        android:background="@drawable/bg_blue_5"
        app:layout_constraintBottom_toBottomOf="@+id/btn_clear"
        app:layout_constraintStart_toEndOf="@+id/btn_clear"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>