<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="265dp"
    android:layout_height="465dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/top_img"
        android:layout_width="265dp"
        android:layout_height="125dp"
        app:srcCompat="@drawable/update_bg_app_top"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-3dp"
        android:background="#FFFFFFFF"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_img">

        <TextView
            android:id="@+id/update_current_version_tx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#333333"
            android:textSize="16sp"
            tools:text="当前版本: 1"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/update_latest_version_tx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#333333"
            android:textSize="16sp"
            tools:text="最新版本: 2"
            app:layout_constraintTop_toBottomOf="@+id/update_current_version_tx"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginVertical="10dp"
            app:layout_constraintTop_toBottomOf="@+id/update_latest_version_tx"
            app:layout_constraintBottom_toTopOf="@+id/update_version_btn">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/update_version_desc_tx"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="120dp"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    tools:text="版本版本描述版本描述n描述"/>

            </LinearLayout>

        </ScrollView>

        <TextView
            android:id="@+id/update_version_btn"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#E94339"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:text="Upgrade"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>