<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/logout_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_logout"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        
    </androidx.constraintlayout.widget.ConstraintLayout>
    
    <TextView
        android:id="@+id/login_user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="sa"
        android:textSize="18sp"
        android:textColor="@color/black"
        android:layout_marginBottom="15dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_inbound"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="105dp"
        android:src="@drawable/logo"
        android:layout_marginBottom="45dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_inbound"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/btn_inbound"
        android:layout_width="240dp"
        android:layout_height="80dp"
        android:text="Inbound"
        android:textSize="22sp"
        android:gravity="center"
        android:textColor="#0055A3"
        android:textStyle="bold"
        android:layout_marginTop="130dp"
        android:background="@drawable/bg_main_btn"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btn_outbound"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/btn_outbound"
        android:layout_width="240dp"
        android:layout_height="80dp"
        android:text="Outbound"
        android:textSize="22sp"
        android:gravity="center"
        android:textColor="#0055A3"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_main_btn"
        app:layout_constraintTop_toBottomOf="@+id/btn_inbound"
        app:layout_constraintBottom_toTopOf="@+id/btn_inventory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/btn_inventory"
        android:layout_width="240dp"
        android:layout_height="80dp"
        android:textSize="22sp"
        android:text="Inventory"
        android:gravity="center"
        android:textColor="#0055A3"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_main_btn"
        app:layout_constraintBottom_toTopOf="@+id/btn_find_item"
        app:layout_constraintTop_toBottomOf="@+id/btn_outbound"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/btn_find_item"
        android:layout_width="240dp"
        android:layout_height="80dp"
        android:text="Find Item"
        android:textSize="22sp"
        android:gravity="center"
        android:textColor="#0055A3"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_main_btn"
        app:layout_constraintBottom_toTopOf="@+id/btn_dashboard"
        app:layout_constraintTop_toBottomOf="@+id/btn_inventory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/btn_dashboard"
        android:layout_width="240dp"
        android:layout_height="80dp"
        android:text="Dashboard"
        android:textSize="22sp"
        android:gravity="center"
        android:textColor="#0055A3"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_main_btn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_find_item"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>