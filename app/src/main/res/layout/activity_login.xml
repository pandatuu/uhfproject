<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <ImageView
        android:id="@+id/main_img"
        android:layout_width="250dp"
        android:layout_height="145dp"
        android:src="@drawable/logo"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@+id/login_tittle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/login_tittle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Singapore_Post"
        android:textStyle="bold"
        android:textSize="32sp"
        android:textColor="#717070"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/user_name_layout" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/user_name_layout"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginTop="40dp"
        android:layout_marginHorizontal="30dp"
        android:background="@drawable/bg_blue_border_5"
        app:layout_constraintBottom_toTopOf="@+id/password_layout"
        app:layout_constraintTop_toBottomOf="@+id/login_tittle">

        <ImageView
            android:id="@+id/img_login"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_login"
            android:layout_marginStart="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/edt_username"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@null"
            android:paddingHorizontal="8dp"
            app:layout_constraintStart_toEndOf="@+id/img_login"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/password_layout"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:background="@drawable/bg_blue_border_5"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/user_name_layout">

        <ImageView
            android:id="@+id/img_password"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_password"
            android:layout_marginStart="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/edt_password"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@null"
            android:paddingHorizontal="8dp"
            app:layout_constraintStart_toEndOf="@+id/img_password"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <CheckBox
        android:id="@+id/check_read_me"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="@+id/password_layout"
        app:layout_constraintTop_toBottomOf="@+id/password_layout" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="readme"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@+id/check_read_me"
        app:layout_constraintTop_toTopOf="@+id/check_read_me"
        app:layout_constraintBottom_toBottomOf="@+id/check_read_me" />


    <TextView
        android:id="@+id/btn_login"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="Login"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:background="@drawable/bg_blue_5"
        android:gravity="center"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/check_read_me"
        app:layout_constraintStart_toStartOf="@+id/password_layout"
        app:layout_constraintEnd_toEndOf="@+id/password_layout" />

    <TextView
        android:id="@+id/tv_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        tools:text="123"
        android:textSize="15dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>