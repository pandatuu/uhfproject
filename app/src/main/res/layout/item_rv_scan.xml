<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginVertical="3dp"
    android:paddingVertical="5dp"
    android:background="@drawable/bg_white_10">

    <TextView
        android:id="@+id/item_sn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        tools:text="SFSBFDBSBSBN"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintWidth_percent="0.1"
        app:layout_constraintEnd_toStartOf="@+id/item_traking_id"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/item_traking_id"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        tools:text="Tracking ID"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintWidth_percent="0.35"
        app:layout_constraintEnd_toStartOf="@+id/item_postal_code"
        app:layout_constraintStart_toEndOf="@+id/item_sn"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/item_postal_code"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        tools:text="Postal Code"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintWidth_percent="0.2"
        app:layout_constraintEnd_toStartOf="@+id/item_beat"
        app:layout_constraintStart_toEndOf="@+id/item_traking_id"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/item_beat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        tools:text="Beat"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintWidth_percent="0.2"
        app:layout_constraintEnd_toStartOf="@+id/item_other"
        app:layout_constraintStart_toEndOf="@+id/item_postal_code"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/item_other"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        tools:text="Other"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintWidth_percent="0.15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/item_beat"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>