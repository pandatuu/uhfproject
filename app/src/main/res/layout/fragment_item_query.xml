<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_main_btn"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/tv_back"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingVertical="18dp"
            android:paddingStart="10dp"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Item Query"
            android:textColor="#0055A3"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <TextView
        android:id="@+id/tv_epc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="15dp"
        android:text="Epc:"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="@+id/title_layout"
        app:layout_constraintTop_toBottomOf="@+id/title_layout" />

    <TextView
        android:id="@+id/epc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textSize="15sp"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="@+id/tv_epc"
        app:layout_constraintStart_toEndOf="@+id/tv_epc"
        app:layout_constraintTop_toTopOf="@+id/tv_epc"
        tools:text="4000" />

    <TextView
        android:id="@+id/tv_tracking_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Tracking#:"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="@+id/tv_epc"
        app:layout_constraintTop_toBottomOf="@+id/tv_epc" />

    <TextView
        android:id="@+id/tracking_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textSize="15sp"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="@+id/tv_tracking_id"
        app:layout_constraintStart_toEndOf="@+id/tv_tracking_id"
        app:layout_constraintTop_toTopOf="@+id/tv_tracking_id"
        tools:text="4000" />

    <TextView
        android:id="@+id/tv_postal_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Postal code:"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="@+id/tv_tracking_id"
        app:layout_constraintTop_toBottomOf="@+id/tv_tracking_id" />

    <TextView
        android:id="@+id/postal_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textSize="15sp"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="@+id/tv_postal_code"
        app:layout_constraintStart_toEndOf="@+id/tv_postal_code"
        app:layout_constraintTop_toTopOf="@+id/tv_postal_code"
        tools:text="4000" />

    <TextView
        android:id="@+id/tv_rb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="RB:"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="@+id/tv_postal_code"
        app:layout_constraintTop_toBottomOf="@+id/tv_postal_code" />

    <TextView
        android:id="@+id/rb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textSize="15sp"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="@+id/tv_rb"
        app:layout_constraintStart_toEndOf="@+id/tv_rb"
        app:layout_constraintTop_toTopOf="@+id/tv_rb"
        tools:text="4000" />

    <TextView
        android:id="@+id/tv_beat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Beat:"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="@+id/tv_rb"
        app:layout_constraintTop_toBottomOf="@+id/tv_rb" />

    <TextView
        android:id="@+id/beat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textSize="15sp"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="@+id/tv_beat"
        app:layout_constraintStart_toEndOf="@+id/tv_beat"
        app:layout_constraintTop_toTopOf="@+id/tv_beat"
        tools:text="4000" />


    <TextView
        android:id="@+id/tv_txt1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:text="Lifecycle tracking:"
        android:textColor="#1716FE"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_beat" />


    <TextView
        android:id="@+id/tv_item_sn"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:gravity="center"
        android:text="SN"
        android:textColor="@color/black"
        android:textSize="13sp"
        android:background="@drawable/bg_header_border"
        android:layout_marginStart="10dp"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_item_db"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_txt1"
        app:layout_constraintHorizontal_weight="0.1" />

    <TextView
        android:id="@+id/tv_item_db"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:gravity="center"
        android:text="RB"
        android:textColor="@color/black"
        android:textSize="13sp"
        android:background="@drawable/bg_header_border_1"
        app:layout_constraintEnd_toStartOf="@+id/tv_item_total"
        app:layout_constraintStart_toEndOf="@+id/tv_item_sn"
        app:layout_constraintTop_toTopOf="@+id/tv_item_sn"
        app:layout_constraintHorizontal_weight="0.35" />

    <TextView
        android:id="@+id/tv_item_total"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:gravity="center"
        android:text="Total"
        android:textColor="@color/black"
        android:textSize="13sp"
        android:background="@drawable/bg_header_border_1"
        app:layout_constraintEnd_toStartOf="@+id/tv_item_inbound_completed"
        app:layout_constraintStart_toEndOf="@+id/tv_item_db"
        app:layout_constraintTop_toTopOf="@+id/tv_item_sn"
        app:layout_constraintHorizontal_weight="0.15" />

    <TextView
        android:id="@+id/tv_item_inbound_completed"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:gravity="center"
        android:text="inbound\ncomplete"
        android:textColor="@color/black"
        android:textSize="13sp"
        android:background="@drawable/bg_header_border_1"
        app:layout_constraintEnd_toStartOf="@+id/tv_item_outbound_completed"
        app:layout_constraintStart_toEndOf="@+id/tv_item_total"
        app:layout_constraintTop_toTopOf="@+id/tv_item_sn"
        app:layout_constraintHorizontal_weight="0.2" />

    <TextView
        android:id="@+id/tv_item_outbound_completed"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:gravity="center"
        android:text="outbound\ncomplete"
        android:textColor="@color/black"
        android:textSize="13sp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/bg_header_border_1"
        app:layout_constraintStart_toEndOf="@+id/tv_item_inbound_completed"
        app:layout_constraintTop_toTopOf="@+id/tv_item_sn"
        app:layout_constraintHorizontal_weight="0.2" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dashboard_rv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_item_sn"
        tools:listitem="@layout/item_dashboard" />

</androidx.constraintlayout.widget.ConstraintLayout>