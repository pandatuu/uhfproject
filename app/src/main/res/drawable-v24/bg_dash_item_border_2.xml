<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">


    <!-- 右侧边框 -->
    <item
        android:top="-10dp"
        android:left="-10dp"
        android:right="0dp"
        android:bottom="-10dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#000000" />
            <padding android:right="1dp" />
        </shape>
    </item>

    <!-- 底部边框 -->
    <item
        android:top="-10dp"
        android:left="-10dp"
        android:right="-10dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#000000" />
            <padding android:bottom="1dp" />
        </shape>
    </item>
</layer-list>